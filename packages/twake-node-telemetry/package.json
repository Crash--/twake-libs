{
  "name": "@linagora/twake-node-telemetry",
  "type": "module",
  "version": "0.0.0",
  "description": "Logs and Sentry for Twake Node backends",
  "author": "Twake",
  "license": "MIT",
  "engines": {
    "node": "24.x"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/linagora/twake-libs.git",
    "directory": "packages/twake-node-telemetry"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sentry": {
      "types": "./dist/sentry.d.ts",
      "import": "./dist/sentry.js"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@sentry/node": "^10.75.0 || ^11.0.0",
    "pino": "^9.10.0 || ^10.0.0"
  },
  "devDependencies": {
    "@sentry/node": "^11.8.0",
    "@types/node": "^24.19.2",
    "cozy-tsconfig": "^2.0.0",
    "eslint": "10.2.1",
    "eslint-config-cozy-app": "7.0.0",
    "pino": "^10.4.0",
    "vitest": "5.0.1"
  }
}
