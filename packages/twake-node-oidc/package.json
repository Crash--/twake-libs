{
  "name": "@linagora/twake-node-oidc",
  "type": "module",
  "version": "0.0.0",
  "description": "OIDC access tokens, back-channel logout and service tokens for Twake Node backends",
  "author": "Twake",
  "license": "MIT",
  "engines": {
    "node": "24.x"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/linagora/twake-libs.git",
    "directory": "packages/twake-node-oidc"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./fastify": {
      "types": "./dist/fastify.d.ts",
      "import": "./dist/fastify.js"
    },
    "./drizzle": {
      "types": "./dist/drizzle.d.ts",
      "import": "./dist/drizzle.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "jose": "^6.2.12",
    "openid-client": "^6.8.8",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "drizzle-orm": "^1.0.0-rc.4",
    "fastify": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "drizzle-orm": {
      "optional": true
    },
    "fastify": {
      "optional": true
    }
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@types/node": "^24.19.2",
    "cozy-tsconfig": "^2.0.0",
    "drizzle-orm": "1.0.0-rc.4",
    "eslint": "10.2.1",
    "eslint-config-cozy-app": "7.0.0",
    "fastify": "^5.12.5",
    "vitest": "5.0.1"
  }
}
