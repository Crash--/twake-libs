{
  "name": "@linagora/twake-app-skeleton",
  "type": "module",
  "version": "1.0.1",
  "description": "Loading skeletons of Twake applications, shown by the apps that embed them while they load (the Twake Drive picker first)",
  "author": "Twake",
  "license": "MIT",
  "engines": {
    "node": "24.x"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/linagora/twake-libs.git",
    "directory": "packages/twake-app-skeleton"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./drive": {
      "types": "./dist/drive/index.d.ts",
      "import": "./dist/drive/index.js",
      "default": "./dist/drive/index.js"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "start": "tsc -b tsconfig.build.json --watch",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@linagora/twake-icons": ">=2.10.0",
    "@linagora/twake-mui": ">=10.0.0",
    "react": "^18 || ^19"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@linagora/twake-icons": "^2.13.0",
    "@linagora/twake-mui": "^22.0.0",
    "@mui/lab": "^9.0.0-beta.6",
    "@mui/material": "^9.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "cozy-tsconfig": "^2.0.0",
    "jsdom": "^26.1.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "vitest": "5.0.1"
  }
}
