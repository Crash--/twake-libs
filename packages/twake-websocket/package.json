{
  "name": "@linagora/twake-websocket",
  "type": "module",
  "version": "1.1.0",
  "description": "WebSocket management for Twake applications",
  "author": "Twake",
  "license": "MIT",
  "engines": {
    "node": "24.x"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/linagora/twake-libs.git",
    "directory": "packages/twake-websocket"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@linagora/twake-icons": "^2.13.2",
    "@linagora/twake-mui": "^12.0.0",
    "@testing-library/react": "16.0.0",
    "@types/react": "^18.3.0",
    "cozy-tsconfig": "^2.0.0",
    "eslint": "10.2.1",
    "eslint-config-cozy-app": "7.0.0",
    "jsdom": "24.1.0",
    "ky": "^1.14.3",
    "react": "^18.3.0",
    "vitest": "5.0.1",
    "twake-i18n": "^0.6.0"
  }
}
